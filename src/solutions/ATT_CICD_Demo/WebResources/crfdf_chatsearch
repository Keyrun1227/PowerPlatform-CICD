/* ============================================================
   Lazy transcript retrieval
   ============================================================ */

function fetchTranscriptTextByTranscriptId(
    transcriptId
) {

    if (!transcriptId) {
        return Promise.resolve("");
    }

    var fetchXml =

        "<fetch top='1'>" +

        "<entity name='annotation'>" +

        "<attribute name='documentbody' />" +

        "<filter>" +

        "<condition attribute='objectid' " +
        "operator='eq' value='" +
        xmlEncode(
            transcriptId
        ) +
        "' />" +

        "<condition attribute='documentbody' " +
        "operator='not-null' />" +

        "</filter>" +

        "</entity>" +

        "</fetch>";

    return retrieveMultipleWithRetry(
        "annotation",
        "?fetchXml=" +
        encodeURIComponent(
            fetchXml
        ),
        MAX_RETRIES
    )
        .then(function(res) {

            var row =
                (res.entities || [])[0];

            if (
                !row ||
                !row.documentbody
            ) {
                return "";
            }

            var rawText =
                decodeBase64(
                    row.documentbody
                );

            if (!rawText) {
                return "";
            }

            var messages =
                parseTranscriptMessages(
                    rawText
                );

            if (!messages) {
                return "";
            }

            return getFormattedTranscriptFromMessages(
                messages
            );

        })
        .catch(function(err) {

            console.warn(
                "[KWS] Lazy transcript retrieval failed:",
                err
            );

            return "";
        });
}


/*
 * Controlled concurrency instead of Promise.all(500).
 */
function ensureTranscriptTextsForExport(
    items
) {

    var list =
        Array.isArray(items)
            ? items
            : [];

    var missing = [];

    list.forEach(function(c) {

        var match =
            getMatchForConversation(c);

        if (
            match &&
            !match.fullTranscriptText &&
            match.transcriptId
        ) {

            missing.push(match);
        }
    });

    if (!missing.length) {
        return Promise.resolve();
    }

    var cursor = 0;

    function worker() {

        if (
            cursor >=
            missing.length
        ) {
            return Promise.resolve();
        }

        var index =
            cursor++;

        var match =
            missing[index];

        return fetchTranscriptTextByTranscriptId(
            match.transcriptId
        )
            .then(function(text) {

                if (text) {

                    match.fullTranscriptText =
                        text;

                    match.transcriptStatus =
                        "loaded";

                } else {

                    match.transcriptStatus =
                        "unavailable";
                }

            })
            .then(worker);
    }

    var workers = [];

    for (
        var i = 0;
        i < Math.min(
            MAX_TRANSCRIPT_CONCURRENCY,
            missing.length
        );
        i++
    ) {

        workers.push(
            worker()
        );
    }

    return Promise.all(
        workers
    ).then(function() {
        return undefined;
    });
}


/* ============================================================
   CSV
   ============================================================ */

function csvEscape(value) {

    value =
        String(
            value == null
                ? ""
                : value
        );

    if (
        /[",\r\n]/.test(value)
    ) {

        return (
            '"' +
            value.replace(
                /"/g,
                '""'
            ) +
            '"'
        );
    }

    return value;
}


var CSV_HEADERS = [
    "Conversation Id",
    "Subject",
    "Created On",
    "Queue",
    "Agent",
    "Transcript Id",
    "Transcript"
];


function buildCsvRows(items) {

    return items.map(function(c) {

        var match =
            getMatchForConversation(c) ||
            {};

        return [

            c.activityid || "",

            c.subject || "",

            formatCsvDate(
                c.createdon
            ),

            getQueueName(c),

            getConversationAgentName(c),

            match.transcriptId || "",

            match.fullTranscriptText || ""

        ];
    });
}


function downloadCsvFile(
    items,
    filename
) {

    if (!items.length) {
        return;
    }

    var csv =
        [CSV_HEADERS]
            .concat(
                buildCsvRows(items)
            )
            .map(function(row) {

                return row
                    .map(csvEscape)
                    .join(",");

            })
            .join("\r\n");

    var blob =
        new Blob(
            [
                "\ufeff" +
                csv
            ],
            {
                type:
                    "text/csv;charset=utf-8;"
            }
        );

    var url =
        URL.createObjectURL(
            blob
        );

    var link =
        document.createElement(
            "a"
        );

    link.href =
        url;

    link.download =
        filename;

    document.body.appendChild(
        link
    );

    link.click();

    document.body.removeChild(
        link
    );

    URL.revokeObjectURL(
        url
    );
}


