                "operator='eq' value='1' />" +

                "</filter>" +

                "<link-entity name='queuemembership' " +
                "from='queueid' " +
                "to='queueid' " +
                "link-type='inner' alias='cuqm'>" +

                "<filter>" +

                "<condition attribute='systemuserid' " +
                "operator='eq' value='" +
                xmlEncode(userId) +
                "' />" +

                "</filter>" +

                "</link-entity>" +

                "</link-entity>" +

                "</link-entity>"
            );

    var fetchXml =

        "<fetch distinct='true'>" +

        "<entity name='systemuser'>" +

        "<attribute name='systemuserid' />" +
        "<attribute name='fullname' />" +

        "<filter>" +
        exclusionFilter +
        "</filter>" +

