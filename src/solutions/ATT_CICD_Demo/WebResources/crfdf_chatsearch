    return retrieveMultipleWithRetry(
        "systemuser",
        "?fetchXml=" +
        encodeURIComponent(
            fetchXml
        ),
        MAX_RETRIES
    )
        .then(function(res) {

            agentFilter.innerHTML =
                "";

            var agents =
                (res.entities || [])
                    .filter(function(u) {

                        var name =
                            u.fullname || "";

                        var nameLower =
                            name.toLowerCase();

                        if (
                            name.toUpperCase() ===
                            "SYSTEM"
                        ) {
                            return false;
                        }

                        if (
                            name.charAt(0) ===
                            "#"
                        ) {

                            return (
                                nameLower.indexOf(
                                    "botsvc"
                                ) !== -1 ||
                                nameLower.indexOf(
                                    "copilot"
                                ) !== -1
                            );
                        }

                        return true;
                    });

            if (!agents.length) {

                setAgentFilterMessage(
                    "No agents found."
                );

                return;
            }

            agents.forEach(function(u) {

                var div =
                    document.createElement(
                        "div"
                    );

                div.className =
                    "filter-item agent-item";

                var cb =
                    document.createElement(
