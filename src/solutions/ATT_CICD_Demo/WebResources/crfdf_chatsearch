                    normalizeGuid(
                        u.systemuserid
                    );

                var label =
                    document.createElement(
                        "label"
                    );

                label.textContent =
                    u.fullname ||
                    u.systemuserid;

                div.append(
                    cb,
                    label
                );

                agentFilter.appendChild(
                    div
                );
            });

            filterAgentList();

        })
        .catch(function(err) {

            console.error(
                "[KWS] loadAgents failed:",
                err
            );

            setAgentFilterMessage(
                "Failed to load agents."
            );
        });
}


/* ============================================================
   Role detection
   ============================================================ */

function classifyRole(
    type,
    name,
    content,
    role,
    userType
) {

    var combined =
        [
            type,
            name,
            role,
            userType
        ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

    var contentLower =
        String(
            content || ""
        ).toLowerCase();

    if (
        /\b(bot|assistant|copilot|virtual agent|digital assistant)\b/
            .test(combined)
    ) {
        return "Bot";
    }

    if (
        /\bcustomer\b|\bvisitor\b|\bclient\b/
            .test(combined)
    ) {
        return "Customer";
    }

    if (
        /\bagent\b|\badvisor\b|\brepresentative\b|\bcsr\b/
            .test(combined)
    ) {
        return "Agent";
    }

    if (
        /\bcustomer\s*:/
            .test(contentLower)
    ) {
        return "Customer";
    }

    return "";
}


/* ============================================================
   Initialization
   ============================================================ */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        searchBtn.onclick =
            function() {

                var mode =
                    searchModeSelect.value;

                var input =
                    keywordInput.value.trim();

                if (
                    mode === "id"
                ) {

                    var id =
                        normalizeGuid(
                            input
                        );

                    if (
                        !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
                            .test(id)
                    ) {

                        searchStatus.textContent =
                            "Enter a valid Conversation ID.";

                        return;
                    }

                    var token = {};

                    state.searchToken =
                        token;

                    state.searchMode =
                        "id";

                    state.searching =
                        true;

                    state.currentPage =
                        1;

                    state.pageCache =
                        {};

                    state.matchesByConversationId =
                        {};

                    state.currentPageItems =
                        [];

                    state.filteredConversations =
                        [];

                    state.totalMatches =
                        0;

                    state.searchExhausted =
                        true;

                    state.nextQuery =
                        null;

                    searchBtn.disabled =
                        true;

                    searchBtn.textContent =
                        "Searching…";

                    searchStatus.textContent =
                        "Looking up conversation…";

                    results.innerHTML =
                        "";

                    searchByConversationId(
                        id,
                        token
                    )
                        .catch(function(err) {

                            console.error(
                                "[KWS] ID search failed:",
                                err
                            );

                            searchStatus.textContent =
                                "Conversation lookup failed.";

                        })
                        .finally(function() {

                            if (
                                state.searchToken ===
                                token
                            ) {

                                state.searching =
                                    false;

                                searchBtn.disabled =
                                    false;

                                searchBtn.textContent =
                                    "Search";

                                renderCurrentPage();
                            }
                        });

                    return;
                }

                executeKeywordSearch();
            };


        keywordInput.onkeydown =
            function(e) {

                if (
                    e.key ===
                    "Enter"
                ) {

                    searchBtn.click();
                }
            };


        exportCsvBtn.onclick =
            exportCsv;

        exportSelectedBtn.onclick =
            exportSelected;


        filterToggleBtn.onclick =
            function() {

                var isOpen =
                    filters.style.display ===
                    "flex";

                filters.style.display =
                    isOpen
                        ? "none"
                        : "flex";

                filterToggleBtn.classList.toggle(
                    "is-active",
                    !isOpen
                );
            };


        clearBtn.onclick =
            clearFilters;


        startDate.onchange =
            applyDate;

        endDate.onchange =
            applyDate;


        queueTextFilter.oninput =
            filterQueueList;

        agentTextFilter.oninput =
            filterAgentList;


        searchModeSelect.onchange =
            function() {

                var isId =
                    searchModeSelect.value ===
                    "id";

                keywordInput.placeholder =
                    isId
                        ? "Enter Conversation ID…"
                        : "Search transcript…";

                filterToggleBtn.disabled =
                    isId;

                if (
                    isId &&
                    filters.style.display ===
                        "flex"
                ) {

                    filters.style.display =
                        "none";

                    filterToggleBtn.classList.remove(
                        "is-active"
                    );
                }

                updateScopeHint();
            };


        if (
            defaultShowFiltersBtn
        ) {

            defaultShowFiltersBtn.onclick =
                showFilters;
        }


        /*
         * Restore only criteria.
         *
         * We deliberately do not restore thousands
         * of previous result rows.
         */
        var restored =
            restoreState();

        updateScopeHint();


        whenXrmReady(
            function() {

                var userId =
                    normalizeGuid(
                        parent.Xrm.Utility
                            .getGlobalContext()
                            .userSettings
                            .userId
                    );

                var directRoleXml =

                    "<fetch>" +

                    "<entity name='role'>" +

                    "<attribute name='name' />" +

                    "<link-entity name='systemuserroles' " +
                    "from='roleid' " +
                    "to='roleid' " +
                    "link-type='inner'>" +

                    "<filter>" +

                    "<condition attribute='systemuserid' " +
                    "operator='eq' value='" +
                    xmlEncode(userId) +
                    "' />" +

                    "</filter>" +

                    "</link-entity>" +

                    "</entity>" +

                    "</fetch>";


                var teamRoleXml =

                    "<fetch>" +

                    "<entity name='role'>" +

                    "<attribute name='name' />" +

                    "<link-entity name='teamroles' " +
                    "from='roleid' " +
                    "to='roleid' " +
                    "link-type='inner'>" +

                    "<link-entity name='teammembership' " +
                    "from='teamid' " +
                    "to='teamid' " +
                    "link-type='inner'>" +

                    "<filter>" +

                    "<condition attribute='systemuserid' " +
                    "operator='eq' value='" +
                    xmlEncode(userId) +
                    "' />" +

                    "</filter>" +

                    "</link-entity>" +

                    "</link-entity>" +

                    "</entity>" +

                    "</fetch>";


                var elevatedLower =
                    ELEVATED_ROLES
                        .map(function(r) {
                            return r.toLowerCase();
                        });


                Promise.all([

                    retrieveMultipleWithRetry(
                        "role",
                        "?fetchXml=" +
                        encodeURIComponent(
                            directRoleXml
                        ),
                        2
                    )
                    .catch(function() {
                        return {
                            entities: []
                        };
                    }),

                    retrieveMultipleWithRetry(
                        "role",
                        "?fetchXml=" +
                        encodeURIComponent(
                            teamRoleXml
                        ),
                        2
                    )
                    .catch(function() {
                        return {
                            entities: []
                        };
                    })

                ])
                    .then(function(roleResults) {

                        var allRoles =
                            roleResults[0]
                                .entities
                                .concat(
                                    roleResults[1]
                                        .entities
                                );

                        state.isSupervisor =
                            allRoles.some(
                                function(e) {

                                    return (
                                        elevatedLower
                                            .indexOf(
                                                (
                                                    e.name ||
                                                    ""
                                                ).toLowerCase()
                                            ) !== -1
                                    );
                                }
                            );

                    })
                    .catch(function() {

                        state.isSupervisor =
                            false;

                    })
                    .then(function() {

                        /*
                         * Load queue and agent filters
                         * independently.
                         */
                        return Promise.all([

                            loadQueues()
                                .catch(
                                    function(err) {

                                        console.error(
                                            "[KWS] Queue loading failed:",
                                            err
                                        );
                                    }
                                ),

                            loadAgents()

                        ]);

                    })
                    .then(function() {

                        filterQueueList();
                        filterAgentList();

                        /*
                         * Restore selected filters,
                         * but do NOT automatically
                         * scan transcripts.
                         */
                        if (restored) {

                            restored
                                .selectedQueueIds
                                .forEach(
                                    function(id) {

                                        var cb =
                                            queueFilter
                                                .querySelector(
                                                    "input[value='" +
                                                    id +
                                                    "']"
                                                );

                                        if (cb) {
                                            cb.checked =
                                                true;
                                        }
                                    }
                                );

                            restored
                                .selectedAgentIds
                                .forEach(
                                    function(id) {

                                        var cb =
                                            agentFilter
                                                .querySelector(
                                                    "input[value='" +
                                                    id +
                                                    "']"
                                                );

                                        if (cb) {
                                            cb.checked =
                                                true;
                                        }
                                    }
                                );

                            filterQueueList();
                            filterAgentList();

                            scopeHint.className =
                                "scope-hint info";

                            scopeHint.textContent =
                                "Previous search criteria restored. Click Search to load production results.";

                        } else {

                            applyDefaultDateScope();

                            results.innerHTML =
                                "<div class='empty-state'>" +
                                "<div><strong>No conversations found</strong></div>" +
                                "<div>Enter a keyword and click Search.</div>" +
                                "</div>";
                        }

                    });

            }
        );
    }
);


/* ============================================================
   Lightweight self-tests
   ============================================================ */

(function runSelfTests() {

    try {

        console.assert(
            normalizeGuid(
                "{ABC-123}"
            ) ===
            "abc-123",
            "GUID normalization failed"
        );

        console.assert(
            xmlEncode(
                "<test>"
            ) ===
            "&lt;test&gt;",
            "XML encoding failed"
        );

        console.assert(
            csvEscape(
                'hello,"world"'
            ) ===
            '"hello,""world"""',
            "CSV escaping failed"
        );

        console.assert(
            isRetryableRetrieveError({
                statusCode: 429
            }) === true,
            "429 retry classification failed"
        );

        console.assert(
            isRetryableRetrieveError({
                statusCode: 400
            }) === false,
            "400 retry classification failed"
        );

        console.log(
            "[KWS] Production search self-tests completed."
        );

    } catch (e) {

        console.warn(
            "[KWS] Self-tests failed:",
            e
        );
    }

})();

</script>
</body>
</html>
 




