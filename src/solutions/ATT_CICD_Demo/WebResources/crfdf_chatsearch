/* ============================================================
   Persistence
   ============================================================ */

/*
 * Only persist SEARCH CRITERIA and lightweight current page.
 *
 * Never persist thousands of conversations.
 */
function saveState() {

    if (
        !window.sessionStorage
    ) {
        return;
    }

    if (
        state.searchMode === "id"
    ) {
        return;
    }

    var payload = {

        keyword:
            keywordInput.value,

        dateStart:
            startDate.value,

        dateEnd:
            endDate.value,

        currentPage:
            state.currentPage,

        pageSize:
            state.pageSize,

        selectedQueueIds:
            getSelectedQueueIds(),

        selectedAgentIds:
            getSelectedAgentIds(),

        searching:
            state.searching
    };

    try {

        sessionStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(
                payload
            )
        );

    } catch (e) {

        console.warn(
            "[KWS] sessionStorage unavailable"
        );
    }
}


function restoreState() {

    if (
        !window.sessionStorage
    ) {
        return null;
    }

    try {

        var raw =
            sessionStorage.getItem(
                STORAGE_KEY
            );

        if (!raw) {
            return null;
        }

        var saved =
            JSON.parse(raw);

        if (!saved) {
            return null;
        }

        keywordInput.value =
            saved.keyword || "";

        if (
            saved.dateStart &&
            saved.dateEnd
        ) {

            startDate.value =
                saved.dateStart;

            endDate.value =
                saved.dateEnd;

            state.date = {

                start:
                    new Date(
                        saved.dateStart +
                        "T00:00:00"
                    ),

                end:
                    new Date(
                        saved.dateEnd +
                        "T23:59:59"
                    )
            };
        }

        state.pageSize =
            saved.pageSize ||
            25;

        state.currentPage =
            1;

        return {

            selectedQueueIds:
                saved.selectedQueueIds ||
                [],

            selectedAgentIds:
                saved.selectedAgentIds ||
                [],

            searching:
                !!saved.searching

        };

    } catch (e) {

        return null;
    }
}


