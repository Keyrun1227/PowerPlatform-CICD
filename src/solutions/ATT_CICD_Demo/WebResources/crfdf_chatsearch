        "Select all on this page";

    toolbar.append(
        selectAllCb,
        selectAllLabel
    );

    results.appendChild(
        toolbar
    );


    /* Result rows */

    items.forEach(function(c) {

        var match =
            getMatchForConversation(c);

        var cId =
            normalizeGuid(
                c.activityid ||
                c.msdyn_ocliveworkitemid
            );

        var row =
            document.createElement(
                "div"
            );

        row.className =
            "result";

        var cb =
            document.createElement(
                "input"
            );

        cb.type =
            "checkbox";

        cb.className =
            "result-select";

        cb.value =
            cId;

        cb.onchange =
            updateSelectionState;

        var body =
            document.createElement(
                "div"
            );

        body.className =
            "result-body";

        var title =
            document.createElement(
                "div"
            );

        title.className =
            "title";

        title.textContent =
            c.subject ||
            "Untitled conversation";

        title.onclick =
            function() {
                openConversationTab(c);
            };

        var snippet =
            document.createElement(
                "div"
            );

        snippet.className =
            "snippet";

        snippet.innerHTML =
            match &&
            match.snippetHtml
                ? match.snippetHtml
                : "<em>No snippet available</em>";

        body.append(
            title,
            snippet
        );

        var meta =
            document.createElement(
                "div"
            );

        meta.className =
            "result-meta";

        var createdDate =
            c.createdon
                ? localDateString(
                    new Date(
                        c.createdon
                    )
                )
                : "—";

        meta.innerHTML =
            "<div><span class='result-meta-label'>Queue:</span> " +
            escapeHtml(
                getQueueName(c) ||
                "—"
            ) +
            "</div>" +

            "<div><span class='result-meta-label'>Agent:</span> " +
            escapeHtml(
                getConversationAgentName(c)
            ) +
            "</div>" +

            "<div><span class='result-meta-label'>Date:</span> " +
            escapeHtml(
                createdDate
            ) +
            "</div>" +

            "<div><span class='result-meta-label'>Chat ID:</span> " +
            escapeHtml(
                cId
            ) +
            "</div>";

        row.append(
            cb,
            body,
            meta
        );

        results.appendChild(
            row
        );
    });


    /* Pagination */

    var hasNext =
        !state.searchExhausted
            ? !!state.nextQuery ||
              items.length ===
                state.pageSize
            : page <
              Math.ceil(
                  state.totalMatches /
                  state.pageSize
              );

    var hasPrev =
        page > 1;

    if (
        hasNext ||
        hasPrev
    ) {

        var pag =
            document.createElement(
                "div"
            );

        pag.className =
            "pagination";

        var prevBtn =
            document.createElement(
                "button"
            );

        prevBtn.textContent =
            "← Prev";

        prevBtn.disabled =
            !hasPrev;

        prevBtn.onclick =
            function() {

                if (
                    page <= 1
                ) {
                    return;
                }

                var previous =
                    page - 1;

                /*
                 * If previous page is cached,
                 * load instantly.
                 */
                if (
                    state.pageCache[
                        previous
                    ]
                ) {

                    state.currentPage =
                        previous;

                    state.currentPageItems =
                        state.pageCache[
                            previous
                        ].slice();

                    renderCurrentPage();

                    return;
                }

                /*
                 * We don't blindly restart a huge search.
                 */
                searchStatus.textContent =
                    "Previous page is no longer cached. Run the search again.";

            };


        var pageLabel =
            document.createElement(
                "span"
            );

        pageLabel.textContent =
            exactPageLabel();


        var nextBtn =
            document.createElement(
                "button"
            );

        nextBtn.textContent =
            "Next →";

        nextBtn.disabled =
            !hasNext ||
            state.searching;

        nextBtn.onclick =
            function() {

                if (
                    nextBtn.disabled
                ) {
                    return;
                }

                loadPage(
                    page + 1
                );
            };


        var pageSizeWrap =
            document.createElement(
                "div"
            );

        pageSizeWrap.className =
            "page-size-wrap";

        var pageSizeLabel =
            document.createElement(
                "label"
            );

        pageSizeLabel.textContent =
            "Per page:";

        var pageSizeSelect =
            document.createElement(
                "select"
            );

        [10, 25, 50, 100]
            .forEach(function(n) {

                var opt =
                    document.createElement(
                        "option"
                    );

                opt.value =
                    n;

                opt.textContent =
                    n;

                opt.selected =
                    n ===
                    state.pageSize;

                pageSizeSelect
                    .appendChild(
                        opt
                    );
            });

        pageSizeSelect.onchange =
            function() {

                var newSize =
                    parseInt(
                        this.value,
                        10
                    );

                if (
                    !newSize ||
                    newSize ===
                        state.pageSize
                ) {
                    return;
                }

                /*
                 * Page-size change changes the search
                 * boundaries. Restart safely.
                 */
                state.pageSize =
                    newSize;

                executeSearch();
            };

        pageSizeWrap.append(
            pageSizeLabel,
            pageSizeSelect
        );

        pag.append(
            prevBtn,
            pageLabel,
            nextBtn,
            pageSizeWrap
        );

        results.appendChild(
            pag
        );
    }
}


function exactPageLabel() {

    if (
        state.searchExhausted
    ) {

        var totalPages =
            Math.max(
                1,
                Math.ceil(
                    state.totalMatches /
                    state.pageSize
                )
            );

        return (
            "Page " +
            state.currentPage +
            " of " +
            totalPages
        );
    }

    return (
        "Page " +
        state.currentPage +
        " • More results available"
    );
}


